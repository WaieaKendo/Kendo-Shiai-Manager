{
  // Type checking only (Vite builds the app): the entry app/main.js and the ES modules in app/modules.
  // checkJs is off: a file opts in with `// @ts-check` once it has type annotations.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["app/main.js", "app/modules/**/*.js", "app/types/*.d.ts"]
}
