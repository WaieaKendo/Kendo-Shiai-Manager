{
  // Type checking only (Vite builds the app). The app is classic scripts sharing one
  // global scope (see scripts/app-sources.mjs), so app/js/*.js are checked as scripts.
  // checkJs is off: a file opts in with `// @ts-check` once it has type annotations.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["app/js/*.js", "app/types/*.d.ts"]
}
